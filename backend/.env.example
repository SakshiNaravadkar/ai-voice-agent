# Copy this file to .env and fill in your own values.
PORT=5000

# Get a free API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq-hosted open-weight model. Change this if your Groq account uses another model.
GROQ_MODEL=openai/gpt-oss-20b

# Free API key from https://app.tavily.com/ for real-time web search.
# Leave empty to disable web search (the assistant then answers from its own knowledge).
TAVILY_API_KEY=your_tavily_api_key_here
